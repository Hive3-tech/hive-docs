{
  "name": "@hive3/docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "redirects": "node scripts/gen-redirects.mjs",
    "agent-setup": "node scripts/gen-agent-setup.mjs",
    "test": "node --test",
    "build": "node --test && node scripts/gen-agent-setup.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.13.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "github-slugger": "2.0.0",
    "minisearch": "7.2.0",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-mdx-frontmatter": "6.0.0",
    "remark-parse": "11.0.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.5.4",
    "unified": "11.0.5",
    "vite": "6.3.5",
    "yaml": "2.9.1"
  }
}
